/* ============================================================
   Color Studio — Thème CLAIR (Light)
   ============================================================ */

QMainWindow, QWidget {
    background-color: #f2f2f2;
    color: #1e1e1e;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

/* ── Conteneurs nommés ── */
QWidget#leftPanel {
    background-color: #f2f2f2;
    border-right: 1px solid #cccccc;
}
QWidget#sidePanel {
    background-color: #e8e8e8;
    border-left: 1px solid #cccccc;
}
QWidget#sectionContent {
    background-color: #eeeeee;
    border-left: 2px solid #b8b8b8;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
QWidget#renderToolbar {
    background-color: #e6e6e6;
    border-bottom: 1px solid #cccccc;
}
QWidget#renderContainer {
    background-color: #d4d4d4;
}
QWidget#controlsTitleBar {
    background-color: #e6e6e6;
    border-bottom: 1px solid #cccccc;
}
QWidget#sideTitleBar {
    background-color: #e6e6e6;
    border-bottom: 1px solid #cccccc;
}

/* ── Menu Bar ── */
QMenuBar {
    background-color: #e6e6e6;
    color: #333333;
    padding: 2px 4px;
    border-bottom: 1px solid #cccccc;
}
QMenuBar::item {
    padding: 4px 10px;
    border-radius: 3px;
}
QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #d4d4d4;
    color: #111111;
}
QMenu {
    background-color: #f2f2f2;
    border: 1px solid #cccccc;
    padding: 3px 0;
}
QMenu::item {
    padding: 6px 18px 6px 12px;
    color: #1e1e1e;
}
QMenu::item:selected {
    background-color: #d8d8d8;
    color: #000000;
}
QMenu::separator {
    height: 1px;
    background: #cccccc;
    margin: 3px 8px;
}

/* ── Scroll ── */
QScrollArea {
    border: none;
    background-color: #f2f2f2;
}
QScrollArea > QWidget > QWidget {
    background-color: #f2f2f2;
}
QScrollBar:vertical {
    border: none;
    background: #e6e6e6;
    width: 6px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: #aaaaaa;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: #888888; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

/* ── Labels ── */
QLabel {
    color: #333333;
    background: transparent;
}

/* ── Collapsible section buttons ── */
QToolButton {
    background-color: #e2e2e2;
    color: #444444;
    border: none;
    border-radius: 4px;
    padding: 7px 10px;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
}
QToolButton:hover   { background-color: #d4d4d4; color: #222222; }
QToolButton:checked {
    background-color: #d8d8d8;
    color: #111111;
    border-left: 2px solid #888888;
}

/* ── Buttons ── */
QPushButton {
    background-color: #e0e0e0;
    color: #333333;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 5px 12px;
    font-size: 12px;
}
QPushButton:hover   { background-color: #d4d4d4; color: #111111; border-color: #aaaaaa; }
QPushButton:pressed { background-color: #c8c8c8; color: #000000; }
QPushButton:disabled { background-color: #ebebeb; color: #aaaaaa; border-color: #d8d8d8; }

/* ── Exposure +/- buttons ── */
QPushButton[text="-"],
QPushButton[text="+"] {
    background-color: #e2e2e2; color: #444444;
    border: 1px solid #c0c0c0; border-radius: 4px;
    font-size: 16px; font-weight: 700; padding: 0;
    min-width: 30px; max-width: 30px;
    min-height: 30px; max-height: 30px;
}
QPushButton[text="-"]:hover, QPushButton[text="+"]:hover { background-color: #d4d4d4; color: #111111; }
QPushButton[text="-"]:pressed, QPushButton[text="+"]:pressed { background-color: #c8c8c8; }

/* ── EV +/- (AE panel) ── */
QPushButton[text="EV +"], QPushButton[text="EV -"], QPushButton[text="EV \u2212"] {
    background-color: #e2e2e2; color: #444444;
    border: 1px solid #c0c0c0; border-radius: 4px;
    padding: 3px 10px; font-size: 12px;
}
QPushButton[text="EV +"]:hover, QPushButton[text="EV -"]:hover { background-color: #d4d4d4; color: #111111; }

/* ── Reset buttons ── */
QPushButton[text="Reset"], QPushButton[text="\u21ba"] {
    background-color: transparent; color: #888888;
    border: 1px solid #cccccc; border-radius: 3px;
    padding: 2px 8px; font-size: 11px;
}
QPushButton[text="Reset"]:hover, QPushButton[text="\u21ba"]:hover {
    background-color: #e0e0e0; color: #444444;
}

/* ── Sliders ── */
QSlider::groove:horizontal { height: 3px; background: #cccccc; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #888888; border: 1px solid #aaaaaa;
    width: 12px; height: 12px; border-radius: 6px; margin: -5px -1px;
}
QSlider::handle:horizontal:hover { background: #555555; border-color: #555555; }
QSlider::sub-page:horizontal { background: #999999; border-radius: 2px; }

/* ── Tooltip ── */
QToolTip {
    background-color: #f5f5f5; color: #1e1e1e;
    border: 1px solid #cccccc; border-radius: 3px;
    padding: 4px 8px; font-size: 11px;
}

/* ── Status bar ── */
QStatusBar {
    background-color: #e6e6e6; color: #888888;
    border-top: 1px solid #cccccc; font-size: 11px; padding: 0 8px;
}

/* ── Separators ── */
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #cccccc; }

/* ── Group box ── */
QGroupBox {
    background-color: #ebebeb; border: 1px solid #c0c0c0;
    border-radius: 5px; margin-top: 16px; padding: 6px;
    color: #666666; font-size: 11px; font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin; subcontrol-position: top left;
    padding: 0 5px; left: 8px; color: #666666;
}
